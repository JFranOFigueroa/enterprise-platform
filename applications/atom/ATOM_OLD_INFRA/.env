# Check-It Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit the real .env file to version control!


DB_HOST=atom-postgres
DB_PORT=5432
DB_NAME=atom
DB_USER=postgres
DB_PASSWORD=postgres

################### FRONTEND ###################

# APP ENV

VITE_BACKEND_URL = "http://localhost:8079"
NODE_ENV = "development"

