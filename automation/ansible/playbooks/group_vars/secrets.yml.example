---
# Enterprise Platform - On-Premise / Production Credentials
# =============================================================================
# GITIGNORED - This file must NEVER be committed to Git.
#
# Setup:
#   cp secrets.yml.example secrets.yml
#   # Edit secrets.yml with your actual values
#
# run-ansible.sh loads this file automatically via --extra-vars "@secrets.yml"
# with the highest precedence (overrides all other variable sources).
# =============================================================================

# =============================================================================
# On-Premise Server Access (required for onprem inventories)
# =============================================================================
# These variables are used by inventory/onprem/hosts.yml and hosts-workers.yml.
# For hosts-local.yml (localhost mode), only onprem_master_node_ip is needed.

# SSH user for Ansible connections
onprem_user: ansible

# Master node: SSH hostname or IP (where Ansible connects)
onprem_master_host: "192.168.1.100"

# Master node: Internal IP (the node_ip that RKE2 will use for cluster communication)
onprem_master_node_ip: "192.168.1.100"

# Path to SSH private key (absolute or ~ expanded)
onprem_private_key: "~/.ssh/enterprise-platform"

# =============================================================================
# Grafana admin password (production monitoring overlay)
# =============================================================================
# Used to create the `grafana-admin` Secret in platform-monitoring on first
# deploy (the kube-prometheus-stack production overlay references it). If unset,
# the deploy creates it with the default 'admin' password and prints a warning.
#
# grafana_admin_password: "s3cure-grafana-password"

# =============================================================================
# Worker Nodes (required only for multi-node with --workers flag)
# =============================================================================
# Uncomment and fill in for worker nodes.
#
# onprem_worker_01_host: "192.168.1.101"
# onprem_worker_01_node_ip: "192.168.1.101"
# onprem_worker_02_host: "192.168.1.102"
# onprem_worker_02_node_ip: "192.168.1.102"

# =============================================================================
# ArgoCD admin password and the tenant-provisioning (TPS) API token
# =============================================================================
# INFORMATIONAL - the playbook does NOT read any variable from this section.
# It is documented here because there is no other obvious place to find it,
# and because both credentials are easy to misconfigure into a silent failure.
#
# ArgoCD admin password
# --------------------
# NOT managed by this playbook. ArgoCD writes argocd-initial-admin-secret once,
# on first install. If you change the admin password from the ArgoCD UI, that
# Secret goes stale and keeps the ORIGINAL value.
#
# That matters because roles/gitops/tasks/main.yml authenticates against
# /api/v1/session using the value from argocd-initial-admin-secret to mint the
# TPS token. Once the UI password diverges, the login returns 401 and the task
# hits its rescue, which only prints a warning:
#
#   TASK [TPS | Generate ArgoCD token via API] ***
#   ... rescued: [previous task] ...
#   TASK [TPS | Token generation failed - will deploy without token] ***
#   WARNING: Could not generate ArgoCD token. The TPS will deploy without a
#   token (tenant sync triggers disabled) instead of failing the playbook.
#
# The run then still reports SUCCESS, because tenant-provisioning probes only
# /healthz. Check for the warning above, or verify directly:
#
#   kubectl -n tenant-provisioning get secret tenant-provisioning-secrets \
#     -o jsonpath='{.data.ARGOCD_TOKEN}' | base64 -d
#
# A literal CHANGE_ME means token minting is broken.
#
# TPS API token
# -------------
# Supplied OUT OF BAND, not by the playbook. Generate it on the master node:
#
#   argocd account update-password --account tps --new-password '<password>'
#   argocd account generate-token --account tps
#
# then paste the token into the per-environment app_vars file (gitignored, so
# it is never committed):
#
#   applications/tenant-provisioning/app_vars/tenant-provisioning-production.yml
#     app_secrets:
#       secrets.argocdToken: "<token>"
#
# Do NOT add argocd_admin_password or argocd_tps_token below: nothing reads
# them, and they would look authoritative while doing nothing. The token only
# reaches the Application when generation is skipped, because main.yml
# overrides app_vars with a freshly minted token whenever minting succeeds.
# Once a real token is present in the Secret, the reuse step picks it up and
# the minting block is skipped entirely.
# =============================================================================
